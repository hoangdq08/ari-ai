# --- CẤU HÌNH FRONTEND ---
FRONTEND_PORT=8080
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# --- CẤU HÌNH ADMIN ---
ADMIN_PORT=8082
ADMIN_API_URL=http://localhost:8081/api/v1/ml-agri
FRONTEND_URL=http://localhost:8080

# --- CẤU HÌNH BACKEND ---
BACKEND_PORT=8081
BACKEND_CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:8082", "http://127.0.0.1:8082", "http://localhost:5173", "http://127.0.0.1:5173"]
GEMINI_API_KEY=your_gemini_api_key_here

# Admin endpoints (ingest/crawl/reset/rebuild/research/ops-events) are gated by this token.
# Leave empty in production to fail-closed (503). Set a long random secret to enable.
NONGTRI_ADMIN_TOKEN=

# Upload size limits (bytes). Defaults below are reasonable for mobile uploads.
NONGTRI_MAX_IMAGE_BYTES=10485760     # 10 MiB
NONGTRI_MAX_DOCUMENT_BYTES=26214400  # 25 MiB
NONGTRI_MAX_AUDIO_BYTES=26214400     # 25 MiB

# In-memory event ring buffer caps (prevents unbounded growth).
NONGTRI_MAX_CRAWL_EVENTS=500
NONGTRI_MAX_ACTIVITY_EVENTS=1000

# --- CẤU HÌNH VECTOR DB (CHROMA) ---
CHROMA_DB_URL=http://chromadb:8000
