# --- CẤU HÌNH FRONTEND ---
FRONTEND_PORT=8080
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8081

# --- CẤU HÌNH ADMIN ---
ADMIN_PORT=8082
ADMIN_API_URL=http://localhost:8081/api/v1/ml-agri
FRONTEND_URL=http://localhost:8080

# --- CẤU HÌNH BACKEND ---
BACKEND_PORT=8081
BACKEND_CORS_ORIGINS=["http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:8082", "http://127.0.0.1:8082", "http://localhost:5173", "http://127.0.0.1:5173"]

# --- LLM CONFIG ---
# Primary provider (default `deepseek`). Falls back to `NONGTRI_LLM_FALLBACK`
# when the primary is unconfigured or fails at runtime. Set the fallback to
# an empty string to disable fallback entirely.
NONGTRI_LLM_PROVIDER=deepseek
NONGTRI_LLM_FALLBACK=ollama
NONGTRI_LLM_ENABLED=true
# Primary timeout is tighter so the user does not wait the full fallback
# window when the cloud is unresponsive.
NONGTRI_LLM_PRIMARY_TIMEOUT_SECONDS=15
NONGTRI_LLM_TIMEOUT_SECONDS=35
NONGTRI_LLM_TEMPERATURE=0.1
# Overrides per-provider default model. Leave unset to fall back to the
# provider-specific default in `llm_client.py`.
# Ollama default: qwen2.5:3b. DeepSeek default: deepseek-v4-flash.
NONGTRI_LLM_MODEL=

# Ollama (local)
NONGTRI_OLLAMA_BASE_URL=http://127.0.0.1:11434

# DeepSeek (cloud, OpenAI-compatible). Models: deepseek-v4-flash (fast/cheap),
# deepseek-v4-pro (thinking). Older deepseek-chat/deepseek-reasoner aliases
# are scheduled to be deprecated on 2026-07-24.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- EMBEDDING CONFIG ---
# Primary embedding provider (default `ollama` for semantic retrieval).
# Falls back to `hashing` (MD5 256-bucket bag-of-words) when the primary
# is unavailable so the index stays writable on dev laptops without Ollama.
NONGTRI_EMBEDDING_PROVIDER=ollama
NONGTRI_EMBEDDING_FALLBACK=hashing
# Ollama-only knobs:
NONGTRI_EMBEDDING_MODEL=nomic-embed-text
NONGTRI_EMBEDDING_TIMEOUT_SECONDS=10
# `NONGTRI_OLLAMA_BASE_URL` (shared with the LLM block above) is reused
# for /api/embeddings.

# Admin endpoints (ingest/crawl/reset/rebuild/research/ops-events) are gated by this token.
# Leave empty in production to fail-closed (503). Set a long random secret to enable.
NONGTRI_ADMIN_TOKEN=

# Upload size limits (bytes). Defaults below are reasonable for mobile uploads.
NONGTRI_MAX_IMAGE_BYTES=10485760     # 10 MiB
NONGTRI_MAX_DOCUMENT_BYTES=26214400  # 25 MiB
NONGTRI_MAX_AUDIO_BYTES=26214400     # 25 MiB

# In-memory event ring buffer caps (prevents unbounded growth).
NONGTRI_MAX_CRAWL_EVENTS=500
NONGTRI_MAX_ACTIVITY_EVENTS=1000

# Rate limits (slowapi syntax: "<count>/<period>"). Per-IP, in-memory per worker.
# For multi-worker production, point storage at Redis: redis://host:6379
NONGTRI_RATE_LIMIT_STORAGE=memory://
NONGTRI_RATE_LIMIT_CHAT=60/minute
NONGTRI_RATE_LIMIT_IMAGE=10/minute
NONGTRI_RATE_LIMIT_ADMIN=30/minute

# --- CẤU HÌNH VECTOR DB (CHROMA) ---
CHROMA_DB_URL=http://chromadb:8000
